# The Craft site the dev server forwards /actions/* to. In the browser the app and Comments' data API
# then share an origin, as they do when the built app is served from the Craft site itself.
COMMENTS_CRAFT_URL=https://comments-starters.ddev.site

# The data API, as the browser sees it. Leave it as it is unless the app is served somewhere else.
VITE_COMMENTS_ENDPOINT=/actions/comments/api

# The post shown first.
VITE_COMMENTS_ENTRY_URI=blog/welcome-to-the-comments-starters

# The starters' home page on the Craft site, which the header links to. Leave it out when the app is
# served from the Craft site itself.
VITE_STARTERS_URL=https://comments-starters.ddev.site/
