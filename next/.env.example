# Comments' data API, as the browser reaches it. This app is on another site from Craft, so members
# sign in with member tokens (tier 3) and guests with a guest session.
NEXT_PUBLIC_COMMENTS_ENDPOINT=https://comments-starters.ddev.site/actions/comments/api

# The same API for this app's server, for the comment count, structured data and minting member
# tokens. It can be an internal address.
COMMENTS_SERVER_URL=https://comments-starters.ddev.site/actions/comments/api

# The Member Token Key from Craft's .env (COMMENTS_MEMBER_TOKEN_KEY). It signs this server's requests
# for member tokens and must never reach the browser. craft/scripts/install.sh fills it in.
COMMENTS_MEMBER_TOKEN_KEY=

# Signs this demo's own sign-in cookie. Any long random string: openssl rand -hex 32
STARTER_SESSION_SECRET=

# This app's public origin, such as https://next.example.com, which member tokens are minted for.
# Locally it's read from each request.
STARTER_PUBLIC_ORIGIN=

# The post shown first.
NEXT_PUBLIC_COMMENTS_ENTRY_URI=blog/welcome-to-the-comments-starters

# The starters' home page on the Craft site, which the header links to. Left empty, it's the site
# the endpoint above is on.
STARTERS_URL=
