# Comments' data API on the Craft site. This app is on another origin, so it reaches Craft through
# CORS as a guest. The Craft site lists this app's origin under Settings → Comments → Other Sites.
VITE_COMMENTS_ENDPOINT=https://comments-starters.ddev.site/actions/comments/api

# The post shown first.
VITE_COMMENTS_ENTRY_URI=blog/welcome-to-the-comments-starters

# The starters' home page on the Craft site, which the header links to. Leave it out when the app is
# served from the Craft site itself.
VITE_STARTERS_URL=https://comments-starters.ddev.site/
