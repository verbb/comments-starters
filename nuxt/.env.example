# Copy to `.env`, which is the file Nuxt reads.

# The data API, as the browser reaches it. The app runs on a subdomain of the Craft site, so this is
# Craft's own URL, and Craft's session cookie comes with each request through credentialed CORS.
NUXT_PUBLIC_COMMENTS_ENDPOINT=https://comments-starters.ddev.site/actions/comments/api

# The data API for the Nuxt server's own reads, the comment count and the JSON-LD. It's never sent
# to the browser, and can be an internal address. Left empty, it's the endpoint above.
COMMENTS_SERVER_URL=https://comments-starters.ddev.site/actions/comments/api

# The Craft site, for the links to sign in and out there.
NUXT_PUBLIC_CRAFT_URL=https://comments-starters.ddev.site

# The post shown first.
NUXT_PUBLIC_COMMENTS_ENTRY_URI=blog/welcome-to-the-comments-starters
