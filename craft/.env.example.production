# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

CRAFT_APP_ID=comments-starters-production
CRAFT_ENVIRONMENT=production

CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=
CRAFT_DB_PASSWORD=
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=false
CRAFT_ALLOW_ADMIN_CHANGES=false
CRAFT_DISALLOW_ROBOTS=true
PRIMARY_SITE_URL=https://comments-starters.verbb.io

# See docs/forge-deployment.md for how the hosted front ends sign in.
NEXT_STARTER_URL=
NUXT_STARTER_URL=
COMMENTS_MEMBER_TOKEN_KEY=
COMMENTS_ALLOWED_ORIGINS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to off for automated browser runs, where Turnstile can't issue a token.
COMMENTS_TURNSTILE=
# Craft reads CRAFT_DEFAULT_COOKIE_DOMAIN itself, and an empty value would override the dev default
# in config/general.php, so leave it commented out unless you need another domain.
# CRAFT_DEFAULT_COOKIE_DOMAIN=.example.com
