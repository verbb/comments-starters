# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

CRAFT_APP_ID=comments-starters
CRAFT_ENVIRONMENT=dev
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true
PRIMARY_SITE_URL=https://comments-starters.ddev.site

# The key the Next starter's server signs member token requests with. Use the same value in
# next/.env.local. Generate one with: openssl rand -hex 32
COMMENTS_MEMBER_TOKEN_KEY=

# Leave these empty for the starters' local ports and Cloudflare's test Turnstile keys.
COMMENTS_ALLOWED_ORIGINS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to off for automated browser runs, where Turnstile can't issue a token.
COMMENTS_TURNSTILE=
# Craft reads CRAFT_DEFAULT_COOKIE_DOMAIN itself, and an empty value would override the dev default
# in config/general.php, so leave it commented out unless you need another domain.
# CRAFT_DEFAULT_COOKIE_DOMAIN=.example.com
